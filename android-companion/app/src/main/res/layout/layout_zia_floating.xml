<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orbRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Animated Gemini Live Style Sphere -->
    <com.ziaai.companion.ZiaOrbView
        android:id="@+id/ziaOrbView"
        android:layout_width="76dp"
        android:layout_height="76dp" />

    <!-- Transparent Floating Mini-Menu on Long Press -->
    <LinearLayout
        android:id="@+id/miniMenuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="#CC090D16"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/menuScreenBtn"
            android:layout_width="156dp"
            android:layout_height="40dp"
            android:background="#331E293B"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="10dp"
            android:text="👁️ Ver Tela"
            android:textAllCaps="false"
            android:textColor="#E0F2FE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/menuCopilotBtn"
            android:layout_width="156dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="#331E293B"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="10dp"
            android:text="🎮 Pode Jogar"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/menuOpenAppBtn"
            android:layout_width="156dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="#3338BDF8"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="10dp"
            android:text="🏠 Abrir App ZIA"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
