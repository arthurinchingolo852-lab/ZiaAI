<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zia AI Live — Modo Flutuante"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Voz em tempo real estilo Gemini Live, bolinha animada por cima de qualquer jogo, visão contínua da tela + áudio interno e Modo Copiloto de Jogos."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Config Inputs -->
        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="#131B2E"
            android:hint="https://seu-servidor-zia.run.app"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/userNameInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="#131B2E"
            android:hint="Seu nome (ex: Arthur)"
            android:inputType="textPersonName"
            android:paddingHorizontal="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <!-- Permission Checklist Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#131B2E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permissões do Android"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permMicStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🎤 Microfone: Verificando..."
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permOverlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🫧 Bolinha Sobreposta: Verificando..."
                android:textColor="#E2E8F0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/permAccStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🎮 Copiloto (Acessibilidade): Verificando..."
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Copiloto Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#131B2E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎮 Modo Copiloto de Jogos"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Permite que a Zia dê toques reais na tela com onda luminosa"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/copilotSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <!-- Primary Launch Buttons -->
        <Button
            android:id="@+id/activateLiveScreenBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="#8B5CF6"
            android:text="🎙️ Ativar ZIA Live + Ver Tela e Som"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/activateVoiceOnlyBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="#38BDF8"
            android:text="🫧 Ativar Só Bolinha de Voz Live"
            android:textColor="#090D16"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="#131B2E"
            android:text="⚙️ Configurar Acessibilidade (Copiloto)"
            android:textColor="#38BDF8"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopOverlayBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="#1E293B"
            android:text="✕ Encerrar ZIA Flutuante"
            android:textColor="#FCA5A5" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Dica: toque rápido na bolinha pausa/retoma o mic. Segure para abrir [Ver Tela], [Pode Jogar] e [Abrir App ZIA]."
            android:textColor="#38BDF8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
